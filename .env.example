# Required API Keys
ANTHROPIC_API_KEY="your-anthropic-api-key" # Needed if proxying *to* Anthropic
OPENAI_API_KEY="a354a1536c0e456cb86421c40c50df18"
GEMINI_API_KEY="your-google-ai-studio-key"

# Optional: Provider Preference and Model Mapping
# Controls which provider (google, openai, or azure) is preferred for mapping haiku/sonnet.
PREFERRED_PROVIDER="azure"

# Azure deployment names - Support for multiple models
BIG_MODEL="gpt-5"      # Latest GPT-5 (uses max_completion_tokens)
SMALL_MODEL="gpt-4.1"  # Traditional GPT-4.1 (uses max_tokens)

# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT="https://tcopenaieus2.openai.azure.com"
AZURE_OPENAI_API_KEY="a354a1536c0e456cb86421c40c50df18"
AZURE_API_VERSION="2025-01-01-preview"
AZURE_DEPLOYMENT_NAME="gpt-5"

# Alternative configurations for different models:
# For GPT-4.1: Set BIG_MODEL="gpt-4.1" and SMALL_MODEL="gpt-4.1-mini"
# For O3: Set BIG_MODEL="o3" and SMALL_MODEL="o3-mini"
# For GPT-4O: Set BIG_MODEL="gpt-4o" and SMALL_MODEL="gpt-4o-mini" 